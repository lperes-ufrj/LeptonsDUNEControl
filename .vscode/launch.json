{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web app (Flask dev server)",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "args": ["--app", "webapp.app:criar_app()", "run", "--port", "8780", "--no-reload", "--no-debugger"],
      "env": { "LEPTONS_CONFIG": "${workspaceFolder}/leptons.conf", "FLASK_DEBUG": "1" },
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "env": { "LEPTONS_CONFIG": "${workspaceFolder}/leptons.conf" },
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
